# Copy to .env and fill in for your deployment. Nothing else needs to
# change in code to point this server at a new venue's database/frontend.

# Mongo connection string, without a database name - each venue gets its
# own database on this connection, selected by username at login
# (see src/db/index.ts). Local dev: run `npm run local-mongo` in another
# terminal, then use its printed URI here.
DATABASE=mongodb://127.0.0.1:27017/

HTTP_PORT=8080
HTTPS_PORT=8443

# Must match the frontend's JWT_SECRET exactly - both sides verify the same
# signed token. Generate one with: openssl rand -hex 48
JWT_SECRET=

# Comma-separated list of frontend origin(s) allowed to call this API with
# credentials (no spaces needed around commas - they're trimmed). Local dev:
# http://localhost:3000
ALLOWED_ORIGINS=
